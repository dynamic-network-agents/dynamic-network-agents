{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.json",
  "title": "Scenario",
  "description": "仿真场景（接口规范 §5.4），含节点/链路/业务流/动态事件。",
  "type": "object",
  "properties": {
    "scenarioId": { "type": "string", "description": "场景唯一标识" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "number" },
    "status": { "type": "string", "description": "场景状态 ScenarioStatus：DRAFT/VALID/ARCHIVED" },
    "seed": { "type": "number", "description": "随机种子（保证可复现）" },
    "durationMs": { "type": "number", "description": "场景时长（ms）" },
    "nodes": { "type": "array", "items": { "$ref": "node.json" } },
    "links": { "type": "array", "items": { "$ref": "link.json" } },
    "flows": { "type": "array", "items": { "$ref": "flow.json" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/ScenarioEvent" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  },
  "required": ["scenarioId", "name", "version", "status", "nodes", "links", "flows"],
  "$defs": {
    "ScenarioEvent": {
      "type": "object",
      "description": "场景动态事件",
      "properties": {
        "eventId": { "type": "string" },
        "eventType": { "type": "string", "description": "事件类型 ScenarioEventType：NODE_ONLINE/NODE_OFFLINE/NODE_MOVE/LINK_UP/LINK_DOWN/LINK_PARAM_CHANGE/LINK_FLAP/BANDWIDTH_CHANGE/FLOW_ADD/FLOW_REMOVE/FLOW_QOS_CHANGE/INTERFERENCE_CHANGE/COORDINATOR_FAILURE/CUSTOM" },
        "triggerAtMs": { "type": "number", "description": "触发时刻（ms）" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "payload": { "type": "object" },
        "durationMs": { "type": "number" },
        "enabled": { "type": "boolean" },
        "repeat": { "type": "object" },
        "description": { "type": "string" }
      },
      "required": ["eventId", "eventType", "triggerAtMs", "targetType", "payload", "enabled"]
    }
  }
}
