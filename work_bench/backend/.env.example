# ===== 观测通道（v1.2）=====
# 仿真器 API 基址（公开接口，语义不变；鉴权头由 SIM_AUTH 决定）
SIM_BASE_URL=http://127.0.0.1:10100/api/open/v1

# 鉴权通道：ctrl（默认，仿真器前端同款，调用落 front_stat，不计入 agent 调用统计）
#           open（显式降级到公开令牌，调用会被记入 agent 统计台账，正式跑不要用）
SIM_AUTH=ctrl

# ctrl 令牌三选一（优先级 SIM_CTRL_TOKEN > SIM_TOKEN_FILE 里的 ctrlToken > run.sh 自动读取
# ../simulator/conf/gateway.json）。留空即可走 run.sh 自动探测。
SIM_CTRL_TOKEN=
SIM_TOKEN_FILE=

# 控制面 API 基址（用于实时业务分类 svc-meta）；留空则按 SIM_BASE_URL 自动推导
# SIM_CTRL_BASE_URL=http://127.0.0.1:10100/api/ctrl/v1

# 兼容旧配置：仅在 SIM_AUTH=open 时别名为公开令牌
SIM_TOKEN=

# ===== 业务分类与候选路径 =====
# 实时分类优先走 svc-meta（只在 ctrl 通道生效；open 通道自动关闭）；置 0 则关闭，退回离线 bg-service.json
WORKBENCH_SVCMETA=1
# 离线场景文件（可选，绝对路径或相对 backend/ 的路径）
# 用于：svc-meta 不可用时的分类兜底（bg-service.json）、改 service 候选路径（service-paths.json）
BG_SERVICE_PATH=
SERVICE_PATHS_PATH=

# ===== 数据健康 / 离线 =====
# 超过该秒数未刷新即标 STALE（默认 3× 前端 2s 轮询）
WORKBENCH_STALE_AFTER_S=6
# 离线模式：只读离线场景文件，不连仿真器（health=offline）
WORKBENCH_OFFLINE=0
# 离线场景拓扑（net-topo.json）；离线模式下必填
NET_TOPO_PATH=

# 分页读取（仿真器 page/size，默认 500、上限 2000；页数上限用于防御异常）
WORKBENCH_PAGE_SIZE=500
WORKBENCH_MAX_PAGES=20

# ===== 写开关 =====
# 改路径会被仿真器记为 source=agent 的 path 事件（无法用令牌隔离）；
# 默认开启便于调试，正式录制/评分期间置 0 关闭，避免污染 agent-events。
WORKBENCH_ALLOW_REPATH=1

# ===== 工作台监听 =====
# 默认仅本机；服务器部署也保持 127.0.0.1，本机浏览器通过 SSH 隧道访问
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000

# 前端静态目录（单进程部署）：默认 ../frontend/dist，存在则后端同源托管；置空则退回纯 API（dev 模式）
# WORKBENCH_STATIC_DIR=

# CORS 白名单（逗号分隔，仅 dev 模式 vite 跨域需要）
WORKBENCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== 仿真器调用 =====
SIM_TIMEOUT_S=6
SIM_DETAIL_WORKERS=8
# 业务详情缓存 TTL（秒）：该时间窗内复用已拉取的详情，降低对仿真器的高频压力
SIM_DETAIL_TTL_S=4
WORKBENCH_AGENT_ID=workbench
