# 仿真器公开 API（Base URL 已含 /api/open/v1 前缀）
SIM_BASE_URL=http://127.0.0.1:10100/api/open/v1

# 公开令牌：三选一（优先级 SIM_TOKEN > SIM_TOKEN_FILE > run.sh 自动读取 gateway.json）
SIM_TOKEN=
SIM_TOKEN_FILE=

# 离线场景文件（可选，绝对路径或相对 backend/ 的路径）
# 用于：业务背景/测试分类（bg-service.json）、改 service 候选路径（service-paths.json）
BG_SERVICE_PATH=
SERVICE_PATHS_PATH=

# 工作台监听（默认仅本机）
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8000

# 仿真器调用
SIM_TIMEOUT_S=6
SIM_DETAIL_WORKERS=8
# 业务详情缓存 TTL（秒）：该时间窗内复用已拉取的详情，降低对仿真器的高频压力
SIM_DETAIL_TTL_S=4
WORKBENCH_AGENT_ID=workbench
